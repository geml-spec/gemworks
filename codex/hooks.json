            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/gemworks.mjs\" codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/gemworks.mjs\" codex",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/gemworks.mjs\" codex",
            "timeout": 30
          }
        ]
      }
    ]
