    "write":   { "title": "写", "description": "按那一种的写法写", "judge": "model", "prevents": "教程里大段讲原理，读者跟不下去" },
    "tryout":  { "title": "照着做一遍", "description": "按文档从头做一遍，每一步都走得通", "judge": "model", "prevents": "文档里的步骤，写的人自己都没跑过" },
    "confirm": { "title": "你确认", "description": "你读过说行", "judge": "you", "prevents": "没人读过就发出去了", "answers": ["行", "要改"] },
