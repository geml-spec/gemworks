=== diagram {#flow format=geml-statechart caption="bugfix"}
{
  "initial": "reproduce",
  "states": {
    "reproduce": { "title": "复现", "description": "版本已确认", "judge": "model", "prevents": "修的不是真正出问题的那个版本或现象" },
    "fix":       { "title": "修", "description": "一个猜测一版", "judge": "model", "prevents": "几个猜测混在一起，不知道是哪个修好的" },
    "verify":    { "title": "验证", "description": "测试通过", "judge": "fact", "expires": true, "prevents": "说修好了，其实没有" },
    "confirm":   { "title": "你确认", "description": "你按过说对", "judge": "you", "prevents": "测试过了，你看到的现象还在" },
    "done":      { "title": "完成", "final": true }
  },
  "transitions": [
    { "from": "reproduce", "to": "fix" },
    { "from": "fix",       "to": "verify" },
    { "from": "verify",    "to": "confirm" },
    { "from": "confirm",   "to": "done", "approval": true },
    { "from": "confirm",   "to": "reproduce", "guard": "你说没好" }
  ]
}
