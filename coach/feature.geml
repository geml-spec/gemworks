=== diagram {#flow format=geml-statechart caption="新功能"}
{
  "initial": "mockup",
  "states": {
    "mockup":  { "title": "样稿", "description": "你看过说行", "judge": "you", "prevents": "做出来不是你要的，返工最贵", "answers": ["行", "要改"] },
    "build":   { "title": "实现", "description": "一个模块一版", "judge": "model", "prevents": "一次改太多，出了错找不到在哪" },
    "verify":  { "title": "验证", "description": "测试通过", "judge": "fact", "expires": true, "prevents": "说做完了，其实跑不起来" },
    "confirm": { "title": "你确认", "description": "你用过说对", "judge": "you", "prevents": "测试过了，但不是你要的样子" },
    "done":    { "title": "完成", "final": true }
  },
  "transitions": [
    { "from": "mockup",  "to": "build" },
    { "from": "build",   "to": "verify" },
    { "from": "verify",  "to": "confirm" },
    { "from": "confirm", "to": "done", "approval": true },
    { "from": "confirm", "to": "build", "guard": "你说不对" },
    { "from": "confirm", "to": "mockup", "guard": "方向不对" }
  ]
}
